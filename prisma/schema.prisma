// ============================================
// PHASE 3 — ENTERPRISE ASSIGNMENT ENGINE
// ============================================

enum AssignmentType {
  AUTOMATIC
  MANUAL
  RECOMMENDED
  REASSIGNMENT
}

enum AssignmentEntityType {
  DELIVERY_TASK
  WORK_QUEUE_ITEM
  ESCALATION
  DOCUMENT
}

model Assignment {
  id              String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  assignmentType  AssignmentType         @default(MANUAL) @map("assignment_type")
  entityType      AssignmentEntityType   @map("entity_type")
  entityId        String                @map("entity_id") @db.Uuid
  status          String                @default("ASSIGNED") // ASSIGNED, ACCEPTED, REJECTED, STARTED, COMPLETED, CANCELLED

  assignedToId    String                @map("assigned_to_id") @db.Uuid
  assignedTo      User                  @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedById    String?               @map("assigned_by_id") @db.Uuid
  assignedBy      User?                 @relation("AssignedBy", fields: [assignedById], references: [id])
  recommendedById String?               @map("recommended_by_id") @db.Uuid
  recommendedBy   User?                 @relation("RecommendedBy", fields: [recommendedById], references: [id])

  departmentId    String?               @map("department_id") @db.Uuid
  branchId        String?               @map("branch_id") @db.Uuid

  reason          String?
  notes           String?

  // Timing
  assignedAt      DateTime              @default(now()) @map("assigned_at")
  acceptedAt      DateTime?             @map("accepted_at")
  rejectedAt      DateTime?             @map("rejected_at")
  rejectedReason  String?               @map("rejected_reason")
  startedAt       DateTime?             @map("started_at")
  completedAt     DateTime?             @map("completed_at")
  cancelledAt     DateTime?             @map("cancelled_at")

  metadata        Json?                 @db.JsonB

  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@index([assignedToId, status])
  @@index([entityType, entityId])
  @@index([departmentId])
  @@index([assignedAt])
  @@map("assignments")
}

model AssignmentPreference {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  maxConcurrent   Int      @default(5) @map("max_concurrent")
  preferredQueues String[] @map("preferred_queues")
  preferredBranch String?  @map("preferred_branch")
  isAvailable     Boolean  @default(true) @map("is_available")
  maxWorkload     Int      @default(20) @map("max_workload")

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId])
  @@map("assignment_preferences")
}

// ============================================
// PHASE 3 — ENTERPRISE DOCUMENT ENGINE
// ============================================

enum DocumentStatus {
  DRAFT
  GENERATED
  SIGNED
  ARCHIVED
  CANCELLED
}

enum DocumentType {
  QUOTE
  BOOKING
  HAWB
  MAWB
  MANIFEST
  COMMERCIAL_INVOICE
  CUSTOMER_INVOICE
  RECEIPT
  WAREHOUSE_RECEIPT
  DELIVERY_NOTE
  PROOF_OF_DELIVERY
  CARGO_LABEL
  PACKING_LIST
  CUSTOM_DOCUMENT
}

model DocumentTemplate {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String
  code        String       @unique
  documentType DocumentType @map("document_type")
  content     String       // HTML template content
  variables   Json         // Template variable definitions
  version     Int          @default(1)
  isActive    Boolean      @default(true) @map("is_active")
  departmentId String?     @map("department_id") @db.Uuid
  documents    Document[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([documentType, isActive])
  @@index([code])
  @@map("document_templates")
}

model Document {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  documentNumber  String         @unique @map("document_number")
  documentType    DocumentType   @map("document_type")
  status          DocumentStatus @default(DRAFT)
  templateId      String?        @map("template_id") @db.Uuid

  // Entity
  entityType      String         @map("entity_type")
  entityId        String         @map("entity_id") @db.Uuid
  entityNumber    String?        @map("entity_number")

  // Content
  title           String?
  content         String?        // Rendered HTML
  contentData     Json?          @map("content_data") // Data used to render
  fileUrl         String?        @map("file_url")
  fileSize        Int?           @map("file_size")
  mimeType        String?        @default("application/pdf") @map("mime_type")

  // Versioning
  version         Int            @default(1)
  previousVersionId String?      @map("previous_version_id") @db.Uuid

  // Signature
  signature       String?        // base64 signature image
  signedById      String?        @map("signed_by_id") @db.Uuid
  signedBy        User?          @relation("DocumentSignedBy", fields: [signedById], references: [id])
  signedAt        DateTime?      @map("signed_at")

  // Barcode / QR
  barcode         String?
  qrCode          String?        @map("qr_code")

  // Audit
  generatedById   String         @map("generated_by_id") @db.Uuid
  generatedBy     User           @relation("DocumentGeneratedBy", fields: [generatedById], references: [id])
  generatedAt     DateTime       @default(now()) @map("generated_at")

  printedAt       DateTime?      @map("printed_at")
  emailedAt       DateTime?      @map("emailed_at")
  downloadedAt    DateTime?      @map("downloaded_at")

  metadata        Json?          @db.JsonB
  notes           String?

  template DocumentTemplate? @relation(fields: [templateId], references: [id])
  previousVersion Document?   @relation("DocumentVersion", fields: [previousVersionId], references: [id])
  nextVersions    Document[]   @relation("DocumentVersion")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([documentType, status])
  @@index([entityType, entityId])
  @@index([documentNumber])
  @@index([templateId])
  @@index([generatedById])
  @@index([signedById])
  @@map("documents")
}

// ============================================
// PHASE 3 — ENTERPRISE BACKGROUND JOB ENGINE
// ============================================

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  RETRYING
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model BackgroundJob {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobNumber       String       @unique @map("job_number")
  jobType         String       @map("job_type") // INVOICE_GENERATION, PDF_GENERATION, EMAIL, SMS, NOTIFICATION, TCRA_RETRY, KPI_REFRESH, REPORT_GENERATION, etc.
  status          JobStatus    @default(PENDING)
  priority        JobPriority  @default(NORMAL)
  queueName       String       @default("default") @map("queue_name")

  // Entity
  entityType      String?      @map("entity_type")
  entityId        String?      @map("entity_id") @db.Uuid

  // Payload
  payload         Json         @db.JsonB
  result          Json?        @db.JsonB
  error           String?

  // Timing
  scheduledAt     DateTime?    @map("scheduled_at")
  startedAt       DateTime?    @map("started_at")
  completedAt     DateTime?    @map("completed_at")
  durationMs      Int?         @map("duration_ms")

  // Retry
  attempts        Int          @default(0)
  maxAttempts     Int          @default(3) @map("max_attempts")
  nextRetryAt     DateTime?    @map("next_retry_at")
  lastError       String?      @map("last_error")

  // Created by
  createdById     String       @map("created_by_id") @db.Uuid
  createdBy       User         @relation(fields: [createdById], references: [id])

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([status, queueName])
  @@index([jobType, status])
  @@index([scheduledAt])
  @@index([priority])
  @@index([entityType, entityId])
  @@index([nextRetryAt])
  @@map("background_jobs")
}

