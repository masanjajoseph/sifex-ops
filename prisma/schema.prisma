// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuidOssp(map: "uuid-ossp")]
}

// ============================================
// ENUMS
// ============================================

enum WorkflowStage {
  EXPORT
  IMPORT
  WAREHOUSE
  DELIVERY
  COMPLETED
}

enum UserStatus {
  PENDING
  ACTIVE
  INVITED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum CargoStatus {
  INITIATED
  ACCEPTED
  RCS
  LOADED
  MANIFESTED
  OFFLOADED
  DEPARTED
  IN_TRANSIT
  ARRIVED
  UNDER_CLEARANCE
  CUSTOMS_QUERY
  CUSTOMS_HOLD
  RELEASED
  AWAITING_DELIVERY
  OUT_FOR_DELIVERY
  PICKED_UP
  DELIVERED
  POD_SIGNED
  CANCELLED
}

enum PaymentMode {
  PP
  CC
}

enum ShipmentType {
  CAN_GUANGZHOU
  HKG_HONGKONG
  DXB_DUBAI
  CAN_EXPRESS
  MCO_EXPRESS
}

enum StationCode {
  CAN
  HKG
  DAR
  DXB
  NBO
  SHJ
  JNB
  MCT
  BOM
  ADD
  ZNZ
}

enum BillingStatus {
  NOT_BILLED
  DRAFT
  INVOICED
  UNPAID
  PARTIAL_PAID
  PAID
  CREDITED
  REFUNDED
  WAITING_PAYMENT
}

enum PaymentMethod {
  CARD
  MOBILE
  LIPA_NAMBA
  BANK
  CASH
}

enum WarehouseStatus {
  RECEIVED
  RACKED
  PICKED
  LOADED
  OFFLOADED
  RELEASED
  READY_FOR_DISPATCH
  DISPATCHED
}

enum ManifestType {
  EXPORT
  IMPORT
}

enum CustomsStatus {
  DECLARED
  UNDER_REVIEW
  CUSTOMS_HOLD
  CUSTOMS_QUERY
  APPROVED
  RELEASED
  REJECTED
}

// ============================================
// RBAC & USER MANAGEMENT
// ============================================

model User {
  id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String     @unique
  username      String?    @unique
  password      String
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  phone         String?
  avatar        String?
  status        UserStatus @default(PENDING) @map("status")
  emailVerified DateTime?  @map("email_verified")
  lastLoginAt   DateTime?  @map("last_login_at")
  firstLoginAt  DateTime?  @map("first_login_at")
  passwordResetRequired Boolean @default(false) @map("password_reset_required")
  invitedAt     DateTime?  @map("invited_at")
  invitationToken  String? @map("invitation_token")
  invitationExpiresAt DateTime? @map("invitation_expires_at")


  customerId String?   @map("customer_id") @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  positionId String?   @map("position_id") @db.Uuid
  position   Position? @relation(fields: [positionId], references: [id])

  signatureImage String? @map("signature_image")
  signaturePin   String? @map("signature_pin")

  otpCode      String?   @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at")
  otpType      String?   @map("otp_type")
  otpAttempts  Int       @default(0) @map("otp_attempts")

  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  userStations  UserStation[]
  userRoles     UserRole[]
  rider         Rider?
  createdAudits     AuditLog[]    @relation("CreatedBy")
  createdMasterAWBs MasterAWB[]   @relation("CreatedMasterAWBs")
  createdHouseAWBs  HouseAWB[]    @relation("CreatedHouseAWBs")
  createdBillings   BillingRecord[] @relation("CreatedBillings")
  signedBillings    BillingRecord[] @relation("SignedBillings")
  processedPayments Payment[]     @relation("ProcessedPayments")
  deliveryNotes         DeliveryNote[] @relation("DeliveryNoteCreatedBy")
  deliveryTasksCreated  DeliveryTask[] @relation("DeliveryTaskCreatedBy")
  deliveryTasksAssigned DeliveryTask[] @relation("DeliveryTaskAssignedBy")

  // Phase 3 relations
  queueItems              WorkQueueItem[]
  escalationOwned         Escalation[]            @relation("EscalationOwner")
  escalationAssignedBy    Escalation[]            @relation("EscalationAssignedBy")
  escalationActions       EscalationAction[]
  assignmentsAssignedTo   Assignment[]            @relation("AssignedTo")
  assignmentsAssignedBy   Assignment[]            @relation("AssignedBy")
  assignmentsRecommendedBy Assignment[]           @relation("RecommendedBy")
  assignmentPreference    AssignmentPreference?
  documentsSigned         Document[]              @relation("DocumentSignedBy")
  documentsGenerated      Document[]              @relation("DocumentGeneratedBy")
  backgroundJobs          BackgroundJob[]

  passwordResetToken  String?   @map("password_reset_token")
  passwordResetExpiry DateTime? @map("password_reset_expiry")

  invitations Invitation[] @relation("SentInvitations")
  cancelledInvitations Invitation[] @relation("InvitationCancelledBy")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status])
  @@index([deletedAt, status])
  @@map("users")
}

// ============================================
// INVITATION SYSTEM
// ============================================

model Invitation {
  id                String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  email             String
  token             String           @unique
  temporaryPassword String           @map("temporary_password")
  status            InvitationStatus @default(PENDING)
  expiresAt         DateTime         @map("expires_at")
  sentAt            DateTime?        @map("sent_at")
  acceptedAt        DateTime?        @map("accepted_at")
  cancelledAt       DateTime?        @map("cancelled_at")
  cancelledById     String?          @map("cancelled_by_id") @db.Uuid

  user      User  @relation("SentInvitations", fields: [userId], references: [id])
  cancelledBy User? @relation("InvitationCancelledBy", fields: [cancelledById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([token])
  @@index([status])
  @@index([email])
  @@map("invitations")
}

model Role {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String  @unique
  code        String  @unique
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String  @unique
  code        String  @unique
  module      String
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}

model UserRole {
  id     String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  grantedAt DateTime @default(now()) @map("granted_at")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// TENANCY & ORGANIZATION
// ============================================


model Customer {
  id             String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type           String  @default("COMPANY")
  name           String
  code           String  @unique
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  taxId          String? @map("tax_id")

  // KYC fields
  contactPerson  String?   @map("contact_person")
  contactPhone   String?   @map("contact_phone")
  contactEmail   String?   @map("contact_email")
  registrationNo String?   @map("registration_no")
  kycStatus      String    @default("PENDING") @map("kyc_status")
  kycVerifiedAt  DateTime? @map("kyc_verified_at")
  kycVerifiedBy  String?   @map("kyc_verified_by") @db.Uuid

  // Credit
  creditLimit   Float  @default(0) @map("credit_limit")
  creditBalance Float  @default(0) @map("credit_balance")
  paymentTerms  String @default("NET30") @map("payment_terms")

  isActive Boolean @default(true) @map("is_active")


  // Portal users
  users    User[]
  sessions CustomerSession[]
  supportTickets SupportTicket[]

  // Cargo relations
  shipperFor  HouseAWB[] @relation("Shipper")
  receiverFor HouseAWB[] @relation("Receiver")

  // Quotes
  quotationRequests QuotationRequest[]

  // Billing
  billingRecords BillingRecord[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([code])
  @@map("customers")
}

// ============================================
// CUSTOMER PORTAL
// ============================================

model CustomerSession {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  customer     Customer  @relation(fields: [customerId], references: [id])
  token        String    @unique
  otpCode      String?   @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at")
  otpAttempts  Int       @default(0) @map("otp_attempts")
  otpVerified  Boolean   @default(false) @map("otp_verified")
  expiresAt    DateTime? @map("expires_at")
  lastUsedAt   DateTime? @map("last_used_at")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([token])
  @@index([otpCode])
  @@map("customer_sessions")
}

model SupportTicket {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id])
  message    String
  response   String?
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@map("support_tickets")
}

// ============================================
// ORGANIZATION STRUCTURE
// ============================================

model Department {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String  @unique
  code        String  @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")

  users      User[]
  positions  Position[]
  workQueues WorkQueue[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("departments")
}

model Position {
  id           String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String
  code         String  @unique
  description  String?
  departmentId String  @map("department_id") @db.Uuid
  isActive     Boolean @default(true) @map("is_active")

  department Department @relation(fields: [departmentId], references: [id])
  users      User[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("positions")
}

model Branch {
  id             String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String  @unique
  code           String  @unique
  address        String?
  city           String?
  country        String?
  phone          String?
  email          String?
  isActive       Boolean @default(true) @map("is_active")

  users        User[]
  stations     Station[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("branches")
}

model Station {
  id             String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String
  code           StationCode   @unique
  type           String
  address        String?
  city           String?
  country        String?
  branchId       String      @map("branch_id") @db.Uuid
  isActive       Boolean     @default(true) @map("is_active")

  branch             Branch               @relation(fields: [branchId], references: [id])
  userStations       UserStation[]
  warehouseZones     WarehouseZone[]
  warehouseInventory WarehouseInventory[]

  // Cargo relations
  originMasterAWBs      MasterAWB[] @relation("OriginStation")
  destinationMasterAWBs MasterAWB[] @relation("DestinationStation")
  currentMasterAWBs     MasterAWB[] @relation("CurrentStation")

  // Flight relations
  originFlights      Flight[] @relation("FlightOrigin")
  destinationFlights Flight[] @relation("FlightDestination")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("stations")
}

model UserStation {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  stationId String @map("station_id") @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([userId, stationId])
  @@map("user_stations")
}

// ============================================
// SYSTEM SETTINGS
// ============================================

model SystemSettings {
  id                       String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  defaultCurrency          String   @default("USD") @map("default_currency")
  exchangeRate             Float    @default(1.0) @map("exchange_rate")
  taxPercentage            Float    @default(0) @map("tax_percentage")
  defaultChargeableDivisor Int      @default(6000) @map("default_chargeable_divisor")
  autoGenerateTracking     Boolean  @default(true) @map("auto_generate_tracking")
  trackingPrefix           String   @default("SFX") @map("tracking_prefix")
  companyName              String   @map("company_name")
  companyCode              String   @map("company_code")
  operationalStations      String[] @map("operational_stations")


  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================
// REFERENCE DATA (Seedable)
// ============================================

model AWBType {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code      String   @unique
  name      String
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("awb_types")
}

model Currency {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code      String   @unique
  name      String
  symbol    String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("currencies")
}

// ============================================
// FREIGHT RATE SYSTEM
// ============================================

model FreightRate {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shipmentType   ShipmentType @map("shipment_type")
  ratePerKg      Float        @map("rate_per_kg")
  currency       String       @default("USD")
  isActive       Boolean      @default(true) @map("is_active")


  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("freight_rates")
}

// ============================================
// QUOTATION MODULE
// ============================================

model QuotationRequest {
  id             String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId     String @map("customer_id") @db.Uuid
  quoteNumber    String @unique @map("quote_number")
  status         String @default("DRAFT")

  // Shipper info (filled by customer or staff later)
  shipperName    String? @map("shipper_name")
  shipperCompany String? @map("shipper_company")
  shipperAddress String? @map("shipper_address")
  shipperPhone   String? @map("shipper_phone")
  shipperEmail   String? @map("shipper_email")

  // Cargo details
  shipmentType     ShipmentType? @map("shipment_type")
  description      String?
  pieces           Int           @default(0)
  weight           Float         @default(0)
  volume           Float         @default(0)
  chargeableWeight Float         @default(0) @map("chargeable_weight")
  length           Float         @default(0)
  width            Float         @default(0)
  height           Float         @default(0)

  // Routing
  originStationId      String? @map("origin_station_id")
  destinationStationId String? @map("destination_station_id")

  // Costs (filled by staff)
  freightCost       Float     @default(0) @map("freight_cost")
  transportCost     Float     @default(0) @map("transport_cost")
  warehouseCost     Float     @default(0) @map("warehouse_cost")
  customsCost       Float     @default(0) @map("customs_cost")
  consolidationCost Float     @default(0) @map("consolidation_cost")
  totalAmount       Float     @default(0) @map("total_amount")
  currency          String    @default("USD")
  validUntil        DateTime? @map("valid_until")

  // Relations
  customer Customer @relation(fields: [customerId], references: [id])

  // Timestamps
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  @@index([customerId])
  @@index([status])
  @@map("quotation_requests")
}

// ============================================
// CARGO DOMAIN — ENTERPRISE AIR CARGO
// ============================================

model MasterAWB {
  id             String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  // Identifiers
  awbNumber      String  @unique @map("awb_number")
  trackingNumber String  @unique @map("tracking_number")
  orderNumber    String? @map("order_number")

  // Shipper
  senderName    String  @map("sender_name")
  senderAddress String  @map("sender_address")
  senderCompany String? @map("sender_company")
  senderPhone   String? @map("sender_phone")
  senderCity    String? @map("sender_city")
  senderCountry String? @map("sender_country")

  // Receiver
  receiverName    String  @map("receiver_name")
  receiverAddress String  @map("receiver_address")
  receiverCompany String? @map("receiver_company")
  receiverPhone   String? @map("receiver_phone")
  receiverCity    String? @map("receiver_city")
  receiverCountry String? @map("receiver_country")

  // Cargo totals
  description      String?
  freight          Float   @default(0)
  freightRate      Float   @default(0) @map("freight_rate")
  insurance        Float   @default(0)
  awbPieces        Int     @default(0) @map("awb_pieces")
  awbWeight        Float   @default(0) @map("awb_weight")
  chargeableWeight Float   @default(0) @map("chargeable_weight")
  volumeWeight     Float   @default(0) @map("volume_weight")
  length           Float   @default(0)
  width            Float   @default(0)
  height           Float   @default(0)
  volume           Float   @default(0)

  // Commercial
  currency     String       @default("USD")
  customsValue Float        @default(0) @map("customs_value")
  paymentMode  PaymentMode  @map("payment_mode")
  shipmentType ShipmentType @map("shipment_type")

  // Dates
  receivedAt          DateTime? @map("received_at")
  expectedArrivalDate DateTime? @map("expected_arrival_date")

  // Workflow (enterprise state machines — NO booleans)
  cargoStatus     CargoStatus     @default(INITIATED) @map("cargo_status")
  workflowStage   WorkflowStage   @default(EXPORT) @map("workflow_stage")
  workflowStatus  String          @default("DRAFT") @map("workflow_status")
  warehouseStatus WarehouseStatus @default(RECEIVED) @map("warehouse_status")
  billingStatus   BillingStatus   @default(NOT_BILLED) @map("billing_status")

  // Routing
  originStationId      String    @map("origin_station_id") @db.Uuid
  destinationStationId String    @map("destination_station_id") @db.Uuid
  currentStationId     String?   @map("current_station_id") @db.Uuid
  originStation        Station  @relation("OriginStation", fields: [originStationId], references: [id])
  destinationStation   Station  @relation("DestinationStation", fields: [destinationStationId], references: [id])
  currentStation       Station? @relation("CurrentStation", fields: [currentStationId], references: [id])

  // Airline & Flight
  airlineId     String   @map("airline_id")
  flightNumber  String   @map("flight_number")
  departureTime DateTime @map("departure_time")
  arrivalTime   DateTime @map("arrival_time")

  // Manifest
  manifestId     String? @map("manifest_id") @db.Uuid
  manifestNumber String? @map("manifest_number")

  // Customs
  customsDeclarationId String?       @map("customs_declaration_id") @db.Uuid
  customsStatus        CustomsStatus @default(DECLARED) @map("customs_status")

  // Billing
  masterAWBBillingId String? @map("master_awb_billing_id") @db.Uuid

  // Relations
  houseAWBs     HouseAWB[]
  deliveryTasks DeliveryTask[]

  // User tracking
  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("CreatedMasterAWBs", fields: [createdById], references: [id])

  // Timestamps
  createdAt      DateTime  @default(now()) @map("created_at")
  consolidatedAt DateTime? @map("consolidated_at")
  manifestedAt   DateTime? @map("manifested_at")
  departedAt     DateTime? @map("departed_at")
  arrivedAt      DateTime? @map("arrived_at")
  closedAt       DateTime? @map("closed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@index([trackingNumber])
  @@index([awbNumber])
  @@index([flightNumber])
  @@index([cargoStatus])
  @@index([workflowStage])
  @@index([deletedAt, cargoStatus])
  @@index([deletedAt, workflowStage])
  @@index([deletedAt, createdAt])
  @@map("master_awbs")
}

model HouseAWB {
  id             String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  masterAWBId    String? @map("master_awb_id") @db.Uuid

  // Identifiers
  houseAWBNumber String  @unique @map("house_awb_number")
  trackingNumber String  @unique @map("tracking_number")
  orderNumber    String? @map("order_number")

  // Shipper (customer)
  shipperId String   @map("shipper_id") @db.Uuid
  shipper   Customer @relation("Shipper", fields: [shipperId], references: [id])

  // Receiver (customer)
  receiverId String   @map("receiver_id") @db.Uuid
  receiver   Customer @relation("Receiver", fields: [receiverId], references: [id])

  // Cargo details
  description      String?
  pieces           Int     @default(0)
  weight           Float   @default(0)
  volume           Float   @default(0)
  chargeableWeight Float   @default(0) @map("chargeable_weight")
  volumeWeight     Float   @default(0) @map("volume_weight")
  length           Float   @default(0)
  width            Float   @default(0)
  height           Float   @default(0)

  // Commercial
  freight      Float        @default(0)
  freightRate  Float        @default(0) @map("freight_rate")
  insurance    Float        @default(0)
  currency     String       @default("USD")
  customsValue Float        @default(0) @map("customs_value")
  paymentMode  PaymentMode  @map("payment_mode")
  shipmentType ShipmentType @map("shipment_type")

  // Customs
  hsCode             String @map("hs_code")
  originCountry      String @map("origin_country")
  destinationCountry String @map("destination_country")

  // Workflow
  cargoStatus     CargoStatus     @default(INITIATED) @map("cargo_status")
  workflowStage   WorkflowStage   @default(EXPORT) @map("workflow_stage")
  workflowStatus  String          @default("DRAFT") @map("workflow_status")
  warehouseStatus WarehouseStatus @default(RECEIVED) @map("warehouse_status")
  billingStatus   BillingStatus   @default(NOT_BILLED) @map("billing_status")
  paymentMethod   PaymentMethod?  @map("payment_method")

  // Dates
  receivedAt          DateTime? @map("received_at")
  expectedArrivalDate DateTime? @map("expected_arrival_date")

  // Relations
  masterAWB     MasterAWB?    @relation(fields: [masterAWBId], references: [id])
  parcels       Parcel[]
  deliveryTasks DeliveryTask[]

  // Billing & customs
  houseAWBBillingId    String?         @map("house_awb_billing_id") @db.Uuid
  customsDeclarationId String?         @map("customs_declaration_id") @db.Uuid
  billingRecords       BillingRecord[]
  deliveryNotes        DeliveryNote[]
  deliveryAssignments  DeliveryAssignment[]

  // User tracking
  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("CreatedHouseAWBs", fields: [createdById], references: [id])

  // Timestamps
  createdAt      DateTime  @default(now()) @map("created_at")
  pickedUpAt     DateTime? @map("picked_up_at")
  consolidatedAt DateTime? @map("consolidated_at")
  deliveredAt    DateTime? @map("delivered_at")
  signedAt       DateTime? @map("signed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@index([masterAWBId])
  @@index([cargoStatus])
  @@index([workflowStage])
  @@index([trackingNumber])
  @@index([deletedAt, cargoStatus])
  @@index([deletedAt, workflowStage])
  @@index([deletedAt, createdAt])
  @@map("house_awbs")
}

model Parcel {
  id         String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  houseAWBId String @map("house_awb_id") @db.Uuid

  // Identifiers
  parcelTrackingNumber String  @unique @map("parcel_tracking_number")
