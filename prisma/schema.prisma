model SmsHistory {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phoneNumber     String   @map("phone_number")
  message         String
  templateCode    String?  @map("template_code")
  senderId        String?  @map("sender_id")

  // Entity
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id") @db.Uuid
  entityNumber    String?  @map("entity_number")

  // Provider
  provider        String   @default("bonga")    // bonga, twilio, log
  providerMessageId String? @map("provider_message_id")
  providerResponse Json?   @map("provider_response") @db.JsonB

  // Status
  status          String   @default("PENDING") // PENDING, SENT, DELIVERED, FAILED, REJECTED
  deliveryStatus  String?  @map("delivery_status") // DELIVERED, UNDELIVERED, UNKNOWN
  deliveryAt      DateTime? @map("delivered_at")
  error           String?

  // Retry
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3) @map("max_attempts")
  lastAttemptAt   DateTime? @map("last_attempt_at")
  nextRetryAt     DateTime? @map("next_retry_at")

  // Background job
  backgroundJobId String?  @map("background_job_id") @db.Uuid

  // Metadata
  metadata        Json?    @db.JsonB

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([phoneNumber])
  @@index([entityType, entityId])
  @@index([deliveryStatus])
  @@index([createdAt])
  @@index([backgroundJobId])
  @@index([nextRetryAt])
  @@map("sms_history")
}

// ============================================
// PHASE 3.1 — SEARCH HISTORY
// ============================================

model SearchHistory {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  query      String
  entityType String?  @map("entity_type")
  resultCount Int     @default(0) @map("result_count")
  filters    Json?    @db.JsonB

  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([query])
  @@index([userId])
  @@map("search_history")
}

model TcraSnapshotLog {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  dateFrom     DateTime @map("date_from")
  dateTo       DateTime @map("date_to")
  totalEvents  Int      @default(0) @map("total_events")
  response     Json?    @db.JsonB
  status       String   @default("PENDING")
  error        String?
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("tcra_snapshot_logs")
}
