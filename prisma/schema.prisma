// ============================================
// DELIVERY TASKS (Phase 2)
// ============================================

enum DeliveryTaskStatus {
  WAITING_ASSIGNMENT
  ASSIGNED
  STARTED
  ARRIVED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model DeliveryTask {
  id            String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  taskNumber    String              @unique @map("task_number")
  masterAWBId   String?             @map("master_awb_id") @db.Uuid
  houseAWBId    String?             @map("house_awb_id") @db.Uuid
  billingRecordId String?           @map("billing_record_id") @db.Uuid
  invoiceNumber String?             @map("invoice_number")
  customerId    String?             @map("customer_id") @db.Uuid
  customerName  String?             @map("customer_name")
  customerPhone String?             @map("customer_phone")
  pickupAddress  String?            @map("pickup_address")
  deliveryAddress String?           @map("delivery_address")
  priority      String              @default("NORMAL")
  status        DeliveryTaskStatus  @default(WAITING_ASSIGNMENT)
  assignedRiderId String?           @map("assigned_rider_id") @db.Uuid
  assignedById  String?             @map("assigned_by_id") @db.Uuid
  assignmentNote String?            @map("assignment_note")
  assignedAt    DateTime?           @map("assigned_at")
  startedAt     DateTime?           @map("started_at")
  arrivedAt     DateTime?           @map("arrived_at")
  deliveredAt   DateTime?           @map("delivered_at")
  completedAt   DateTime?           @map("completed_at")
  cancelledAt   DateTime?           @map("cancelled_at")
  cancelReason  String?             @map("cancel_reason")
  recipientName  String?            @map("recipient_name")
  recipientPhone String?            @map("recipient_phone")
  signature     String?
  signedAt      DateTime?           @map("signed_at")
  notes         String?
  metadata      Json?               @db.JsonB

  createdById   String              @map("created_by_id") @db.Uuid
  createdBy     User                @relation("DeliveryTaskCreatedBy", fields: [createdById], references: [id])
  assignedRider Rider?              @relation(fields: [assignedRiderId], references: [id])
  assignedBy    User?               @relation("DeliveryTaskAssignedBy", fields: [assignedById], references: [id])
  masterAWB      MasterAWB?         @relation(fields: [masterAWBId], references: [id])
  houseAWB       HouseAWB?          @relation(fields: [houseAWBId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status])
  @@index([assignedRiderId])
  @@index([masterAWBId])
  @@index([houseAWBId])
  @@index([taskNumber])
  @@map("delivery_tasks")
}

model DeliveryAssignment {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  houseAWBId      String?   @map("house_awb_id") @db.Uuid
  masterAWBId     String?   @map("master_awb_id") @db.Uuid
  riderId         String    @map("rider_id") @db.Uuid
  status          String    @default("ASSIGNED")
  pickupAddress   String?   @map("pickup_address")
  deliveryAddress String?   @map("delivery_address")
  recipientName   String?   @map("recipient_name")
  recipientPhone  String?   @map("recipient_phone")
  notes           String?
  assignedAt      DateTime  @default(now()) @map("assigned_at")
  pickedUpAt      DateTime? @map("picked_up_at")
  deliveredAt     DateTime? @map("delivered_at")
  failedAt        DateTime? @map("failed_at")
  failureReason   String?   @map("failure_reason")

  rider   Rider    @relation(fields: [riderId], references: [id])
  houseAWB HouseAWB? @relation(fields: [houseAWBId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([riderId])
  @@index([status])
  @@map("delivery_assignments")
}

model DeliveryNote {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  houseAWBId       String   @map("house_awb_id") @db.Uuid
  deliveryType     String   @default("DELIVERY") @map("delivery_type") // DELIVERY or PICKUP
  status           String   @default("PENDING") // PENDING or SIGNED
  recipientName    String   @map("recipient_name")
  recipientPhone   String?  @map("recipient_phone")
  recipientIdType  String?  @map("recipient_id_type") // NATIONAL_ID, PASSPORT, DRIVERS_LICENSE
  recipientIdNumber String? @map("recipient_id_number")
  relation         String   @default("SELF") // SELF or REPRESENTATIVE
  representativeName String? @map("representative_name")
  signature        String?  // base64 or text signature
  signedAt         DateTime? @map("signed_at")
  notes            String?
  createdById      String   @map("created_by_id") @db.Uuid

  houseAWB  HouseAWB @relation(fields: [houseAWBId], references: [id])
  createdBy User     @relation("DeliveryNoteCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([houseAWBId])
  @@index([status])
  @@map("delivery_notes")
}

// ============================================
// PHASE 3 — ENTERPRISE QUEUE ENGINE
// ============================================

enum QueueStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum QueueItemStatus {
  WAITING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum QueuePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
  VIP
}

model WorkQueue {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  queueNumber   String      @unique @map("queue_number")
  name          String
  code          String
  module        String      // EXPORT, IMPORT, WAREHOUSE, BILLING, DELIVERY
  departmentId  String?     @map("department_id") @db.Uuid
  status        QueueStatus @default(ACTIVE)
  description   String?
  priority      QueuePriority @default(NORMAL)
  maxConcurrent Int         @default(5) @map("max_concurrent")
  averageWaitTime Float?    @map("average_wait_time") // computed

  department Department? @relation(fields: [departmentId], references: [id])
  items      WorkQueueItem[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([module, code])
  @@index([module, status])
  @@index([departmentId])
  @@index([priority])
  @@map("work_queues")
}

model WorkQueueItem {
  id                String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  queueId           String          @map("queue_id") @db.Uuid
  position          Int
  status            QueueItemStatus @default(WAITING)
  priority          QueuePriority   @default(NORMAL)
  priorityScore     Int             @default(0) @map("priority_score")

  // Entity reference
  entityType        String          @map("entity_type")
  entityId          String          @map("entity_id") @db.Uuid
  entityNumber      String?         @map("entity_number") // display number (HAWB#, task#, etc.)
  reference         String?         // customer name, destination, etc.

  // Timing
  enqueuedAt        DateTime        @default(now()) @map("enqueued_at")
  assignedAt        DateTime?       @map("assigned_at")
  startedAt         DateTime?       @map("started_at")
  completedAt       DateTime?       @map("completed_at")
  waitTime          Int?            @map("wait_time") // seconds
  processTime       Int?            @map("process_time") // seconds

  // Assignment
  assignedUserId    String?         @map("assigned_user_id") @db.Uuid
  assignedUser      User?           @relation(fields: [assignedUserId], references: [id])

  // Notes
  notes             String?
  metadata          Json?           @db.JsonB

  queue WorkQueue @relation(fields: [queueId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([queueId, status])
  @@index([queueId, position])
  @@index([entityType, entityId])
  @@index([assignedUserId, status])
  @@index([priority, priorityScore])
  @@index([enqueuedAt])
  @@map("work_queue_items")
}

// ============================================
// PHASE 3 — ENTERPRISE SLA ENGINE
// ============================================

enum SLASeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SLAConfig {
  id              String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String
  code            String      @unique
  module          String      // EXPORT, IMPORT, WAREHOUSE, BILLING, DELIVERY
  workflowStage   String      @map("workflow_stage")
  fromStatus      String?     @map("from_status")
  toStatus        String?     @map("to_status")
  targetMinutes   Int         @map("target_minutes")
  warningMinutes  Int         @default(0) @map("warning_minutes") // trigger warning before breach
  severity        SLASeverity @default(MEDIUM)
  isActive        Boolean     @default(true) @map("is_active")
  departmentId    String?     @map("department_id") @db.Uuid
  slaTrackers     SLATracker[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([module, isActive])
  @@index([workflowStage])
  @@index([code])
  @@map("sla_configs")
}

model SLATracker {
  id             String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slaConfigId    String      @map("sla_config_id") @db.Uuid
  entityType     String      @map("entity_type")
  entityId       String      @map("entity_id") @db.Uuid
  entityNumber   String?     @map("entity_number")

  // Timing
  startedAt      DateTime    @default(now()) @map("started_at")
  targetDeadline DateTime    @map("target_deadline")
  warningAt      DateTime?   @map("warning_at")
  completedAt    DateTime?   @map("completed_at")

  // Status
  status         String      @default("ACTIVE") // ACTIVE, WARNING, BREACHED, COMPLETED, CANCELLED
  durationSeconds Int?       @map("duration_seconds")
  breachedAt     DateTime?   @map("breached_at")
  breachReason   String?     @map("breach_reason")

  slaConfig SLAConfig @relation(fields: [slaConfigId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@index([status])
  @@index([slaConfigId, status])
  @@index([targetDeadline])
  @@map("sla_trackers")
}

// ============================================
// PHASE 3 — ENTERPRISE ESCALATION ENGINE
// ============================================

enum EscalationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EscalationLevel {
  LEVEL_1 // Department Supervisor
  LEVEL_2 // Branch Manager
  LEVEL_3 // Operations Manager
  LEVEL_4 // Executive Team
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Escalation {
  id              String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  escalationNumber String            @unique @map("escalation_number")
  entityType      String             @map("entity_type")
  entityId        String             @map("entity_id") @db.Uuid
  entityNumber    String?            @map("entity_number")

  // Reason
  reason          String
  severity        EscalationSeverity @default(HIGH)
  currentLevel    EscalationLevel    @default(LEVEL_1) @map("current_level")
  status          EscalationStatus   @default(OPEN)

  // Source
  source          String             // SLA_BREACH, MANUAL, RULE, SYSTEM
  slaTrackerId    String?            @map("sla_tracker_id") @db.Uuid
  ruleId          String?            @map("rule_id") @db.Uuid

  // Ownership
  ownerId         String?            @map("owner_id") @db.Uuid
  owner           User?              @relation("EscalationOwner", fields: [ownerId], references: [id])
  assignedById    String?            @map("assigned_by_id") @db.Uuid
  assignedBy      User?              @relation("EscalationAssignedBy", fields: [assignedById], references: [id])

  // Deadlines
  deadlineAt      DateTime?          @map("deadline_at")
  resolvedAt      DateTime?          @map("resolved_at")
  resolution      String?            @map("resolution")
  notes           String?
  actions         EscalationAction[]

  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([severity])
  @@index([currentLevel])
  @@index([entityType, entityId])
  @@index([ownerId])
  @@index([deadlineAt])
  @@map("escalations")
}

model EscalationAction {
  id             String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  escalationId   String             @map("escalation_id") @db.Uuid
  action         String             // ESCALATE, ACKNOWLEDGE, ASSIGN, RESOLVE, CLOSE, NOTE
  fromLevel      EscalationLevel?   @map("from_level")
  toLevel        EscalationLevel?   @map("to_level")
  note           String?
  userId         String             @map("user_id") @db.Uuid
  user           User?              @relation(fields: [userId], references: [id])

  createdAt      DateTime           @default(now()) @map("created_at")

  escalation     Escalation         @relation(fields: [escalationId], references: [id])

  @@index([escalationId])
  @@index([userId])
  @@index([createdAt])
  @@map("escalation_actions")
}

// ============================================
// PHASE 3 — ENTERPRISE BUSINESS RULE ENGINE
// ============================================

enum RuleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RuleTrigger {
  ON_CREATE
  ON_STATUS_CHANGE
  ON_SCHEDULE
  ON_CONDITION
  ON_WORKFLOW_TRANSITION
}

model BusinessRule {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String
  code            String       @unique
  description     String?
  module          String       // EXPORT, IMPORT, WAREHOUSE, BILLING, DELIVERY, SYSTEM
  trigger         RuleTrigger  @default(ON_CONDITION)
  condition       Json         // Rule condition expression (JSON)
  actions         Json         // Actions to execute (JSON array)
  priority        Int          @default(0)
  status          RuleStatus   @default(ACTIVE)
  departmentId    String?      @map("department_id") @db.Uuid
  executionCount  Int          @default(0) @map("execution_count")
  lastExecutedAt  DateTime?    @map("last_executed_at")
  executionLogs   RuleExecutionLog[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([module, status])
  @@index([trigger])
  @@index([code])
  @@map("business_rules")
}

model RuleExecutionLog {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ruleId         String       @map("rule_id") @db.Uuid
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id") @db.Uuid
  trigger        RuleTrigger
  conditionResult Boolean     @map("condition_result")
  actionsExecuted Json        @map("actions_executed")
  error          String?
  executionMs    Int          @map("execution_ms")
  executedById   String?      @map("executed_by_id") @db.Uuid

  rule BusinessRule @relation(fields: [ruleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ruleId])
  @@index([entityType, entityId])
